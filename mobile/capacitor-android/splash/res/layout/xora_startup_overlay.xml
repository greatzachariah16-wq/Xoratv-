<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xora_startup_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xora_startup_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/xora_startup_mark"
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:contentDescription="XoraTV"
            android:scaleType="fitCenter"
            android:src="@drawable/xora_launch_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/xora_loading_dot_1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/xora_loading_dot" />

            <View
                android:id="@+id/xora_loading_dot_2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/xora_loading_dot" />

            <View
                android:id="@+id/xora_loading_dot_3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/xora_loading_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/xora_startup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:minHeight="42dp"
            android:text="Connecting to XoraTV…"
            android:textColor="@color/xora_splash_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/xora_startup_retry"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/xora_retry_button"
            android:minWidth="142dp"
            android:text="Try again"
            android:textAllCaps="false"
            android:textColor="@color/xora_splash_cream"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
