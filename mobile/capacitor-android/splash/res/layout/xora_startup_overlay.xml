<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xora_startup_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xora_startup_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:letterSpacing="0.18"
            android:text="XORA"
            android:textColor="@color/xora_splash_ink"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.10"
            android:text="YOUR WORLD. YOUR ENTERTAINMENT."
            android:textColor="@color/xora_splash_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/xora_loading_dot_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/xora_loading_dot" />

            <View
                android:id="@+id/xora_loading_dot_2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/xora_loading_dot" />

            <View
                android:id="@+id/xora_loading_dot_3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/xora_loading_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/xora_startup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:minHeight="42dp"
            android:text="Connecting to XoraTV…"
            android:textColor="@color/xora_splash_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/xora_startup_retry"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/xora_retry_button"
            android:minWidth="142dp"
            android:text="Try again"
            android:textAllCaps="false"
            android:textColor="@color/xora_splash_cream"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:text="A little patience. A lot to explore."
        android:textColor="@color/xora_splash_muted"
        android:textSize="11sp" />
</FrameLayout>
