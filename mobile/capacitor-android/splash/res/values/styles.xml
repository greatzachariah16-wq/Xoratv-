<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xora" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/xora_splash_clay</item>
        <item name="android:statusBarColor">@color/xora_splash_ink</item>
        <item name="android:navigationBarColor">@color/xora_splash_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/xora_splash_ink</item>
    </style>

    <style name="Theme.Xora.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/xora_splash_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/xora_launch_mark</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Xora</item>
    </style>
</resources>
